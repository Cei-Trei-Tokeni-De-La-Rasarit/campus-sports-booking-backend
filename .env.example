# Copiază acest fișier ca .env și completează parola ta de PostgreSQL.
DATABASE_URL=postgresql+psycopg://postgres:PAROLA_TA@localhost:5432/campus_sports

# Adresele frontend-ului care pot apela API-ul (separate prin virgulă).
CORS_ORIGINS=http://localhost:5173

# Baza de date folosită doar de teste (pytest o golește la fiecare test).
# Numele trebuie să conțină „test”; nu folosi niciodată baza echipei.
TEST_DATABASE_URL=postgresql+psycopg://postgres:PAROLA_TA@localhost:5432/campus_sports_test

# Cheia pentru semnarea token-urilor JWT: în .env pune o valoare aleatorie de cel
# puțin 32 de caractere (vezi README, pasul 3). Valoarea de aici e prea scurtă intenționat.
SECRET_KEY=schimba-aceasta-cheie-secreta
